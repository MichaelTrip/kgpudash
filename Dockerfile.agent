# ── Build stage ────────────────────────────────────────────────────────────
FROM golang:1.23-bookworm AS builder

WORKDIR /src

# Cache Go module downloads.
COPY go.mod go.sum ./
RUN go mod download

# Copy full source (includes pre-generated pb.go files).
COPY . .

# Build the agent binary.
RUN CGO_ENABLED=1 GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/kgpudash-agent \
      ./cmd/agent

# ── Runtime stage ──────────────────────────────────────────────────────────
# Use the NVIDIA CUDA base image so NVML is available at runtime.
# For AMD/Intel-only nodes, a plain debian:bookworm-slim is sufficient.
FROM nvidia/cuda:12.4.1-base-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/kgpudash-agent /usr/local/bin/kgpudash-agent

USER root

EXPOSE 9090

ENTRYPOINT ["/usr/local/bin/kgpudash-agent"]
