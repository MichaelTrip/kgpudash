# ── Build stage ────────────────────────────────────────────────────────────
FROM golang:1.23-bookworm AS builder

WORKDIR /src

# Install protoc and Go protobuf plugins so we can regenerate pb files.
RUN apt-get update && apt-get install -y --no-install-recommends \
      protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@latest \
 && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest

# Cache Go module downloads.
COPY go.mod go.sum ./
RUN go mod download

# Copy full source.
COPY . .

# Regenerate protobuf Go code from the .proto source (always fresh).
RUN PATH="$PATH:$(go env GOPATH)/bin" protoc \
      --go_out=. --go_opt=paths=source_relative \
      --go-grpc_out=. --go-grpc_opt=paths=source_relative \
      internal/proto/gpu/gpu.proto

# Build the server binary (CGO not needed).
RUN CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/kgpudash-server \
      ./cmd/server

# ── Runtime stage ──────────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /out/kgpudash-server /kgpudash-server

EXPOSE 8080

ENTRYPOINT ["/kgpudash-server"]
