# ── Build stage ────────────────────────────────────────────────────────────
FROM golang:1.23-bookworm AS builder

WORKDIR /src

# Cache Go module downloads.
COPY go.mod go.sum ./
RUN go mod download

# Copy full source (includes pre-generated pb.go files).
COPY . .

# Build the server binary (CGO not needed).
RUN CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/kgpudash-server \
      ./cmd/server

# ── Runtime stage ──────────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /out/kgpudash-server /kgpudash-server

EXPOSE 8080

ENTRYPOINT ["/kgpudash-server"]
